# FRED API key (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Contact string sent in the User-Agent of assessor-site requests (polite scraping).
ASSESSOR_CONTACT=you@example.com

# Optional local overrides for offline development (defaults are the public feeds)
# REDFIN_COUNTY_SOURCE=/path/to/county_market_tracker.tsv000.gz
# REDFIN_METRO_SOURCE=/path/to/redfin_metro_market_tracker.tsv000.gz
# REDFIN_ZIP_SOURCE=/path/to/zip_code_market_tracker.tsv000.gz
# ZILLOW_SOURCE_DIR=/path/to/dir/containing/zillow/csvs
# ASSESSOR_SEED_FILE=/path/to/parcel_ids.csv
